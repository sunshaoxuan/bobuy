{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid":"BobuyMediaMetadata","Effect":"Allow","Action":["s3:ListBucket"],"Resource":["arn:aws:s3:::bobuy-media"]},
    {"Sid":"BobuyBinaryDataOnly","Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:AbortMultipartUpload"],"Resource":["arn:aws:s3:::bobuy-media/blobs/v1/sha256/*"]},
    {"Sid":"NoDestructiveAccess","Effect":"Deny","Action":["s3:DeleteObject","s3:DeleteObjectVersion","s3:DeleteBucket","s3:PutBucketPolicy","s3:PutBucketAcl","s3:PutObjectAcl"],"Resource":["arn:aws:s3:::*"]},
    {"Sid":"NoAdministrativeAccess","Effect":"Deny","Action":["admin:*"],"Resource":["arn:aws:s3:::*"]}
  ]
}
