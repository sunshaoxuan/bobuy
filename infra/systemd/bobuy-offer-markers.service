[Unit]
Description=Synchronize Bobuy product offer markers
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/bobuy/scripts/sync-product-offer-markers.py
TimeoutStartSec=100
StateDirectory=bobuy-offer-markers
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bobuy-offer-markers
